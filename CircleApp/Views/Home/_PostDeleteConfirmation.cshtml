<div id="postDeleteDialog" uk-modal>
    <div class="uk-modal-dialog relative overflow-hidden mx-auto bg-white shadow-xl rounded-lg w-[400px]">
        <div class="text-center py-4 border-b mb-0">
            <h2 class="text-sm font-semibold text-black">Confirm Delete</h2>
            <button type="button" class="button-icon absolute top-0 right-0 m-2.5 uk-modal-close">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="p-6 py-4">
            <p class="text-sm text-gray-700">Are you sure you want to delete this post?</p>
        </div>

        <div class="flex justify-end p-4 bg-gray-50 text-sm font-medium gap-2 border-t">
            <button type="button" class="px-4 py-1.5 text-gray-600 bg-white border border-gray-300 rounded-md hover:bg-gray-50 uk-modal-close">Cancel</button>
            
            <form asp-controller="Home" asp-action="PostDelete" method="post" class="inline">
                <input type="hidden" name="postId" id="postId" value="" />
                <button type="submit" class="px-5 py-1.5 bg-red-600 text-white rounded-md hover:bg-red-700 transition-colors">Delete</button>
            </form>
        </div>
    </div>
</div>