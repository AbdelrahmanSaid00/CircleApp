@model List<CircleApp.Data.Models.Story>

<div class="mb-8">
    <h3 class="font-extrabold text-2xl text-black hidden">Stories</h3>

    <div class="relative" tabindex="-1" uk-slider="auto play: true; finite: true" uk-lightbox="animation: scale">
        <div class="py-5 uk-slider-container">
            <ul class="uk-slider-items w-[calc(100%+14px)]" uk-scrollspy="target: > li; cls: uk-animation-scale-up; delay: 20; repeat: true">

                @* Add Story Button *@
                <li class="md:pr-3" uk-scrollspy-class="uk-animation-fade">
                    <div class="md:w-16 md:h-16 w-12 h-12 rounded-full relative border-2 border-dashed grid place-items-center bg-slate-200 border-slate-300 shrink-0 cursor-pointer hover:bg-slate-300 transition-all" 
                         uk-toggle="target: #create-story" title="Create Story">
                        <ion-icon name="camera" class="text-2xl text-slate-700"></ion-icon>
                    </div>
                </li>

                @* Active Stories List *@
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var story in Model)
                    {
                        <li class="md:pr-3 pr-2 hover:scale-[1.15] hover:-rotate-2 duration-300 relative group">
                            <a href="@story.ImageUrl" data-caption="@story.User?.FullName - Story (@story.DateCreated.ToString("g"))">
                                <div class="md:w-16 md:h-16 w-12 h-12 relative md:border-4 border-2 shadow border-white rounded-full overflow-hidden p-0.5 bg-gradient-to-tr from-pink-500 via-red-500 to-yellow-400">
                                    <img src="@(story.User?.ProfilePictureUrl ?? "/images/avatar/user.png")" 
                                         alt="@story.User?.FullName" 
                                         class="w-full h-full rounded-full object-cover" />
                                </div>
                            </a>

                            @* Delete Story Button for Story Owner *@
                            @if (story.UserId == 1)
                            {
                                <form asp-controller="Home" asp-action="DeleteStory" method="post" 
                                      onsubmit="return confirm('Are you sure you want to delete this story?');" 
                                      class="absolute -top-1 -right-1 z-10 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <input type="hidden" name="storyId" value="@story.Id" />
                                    <button type="submit" class="w-6 h-6 bg-red-600 text-white rounded-full flex items-center justify-center shadow-md hover:bg-red-700 transition-colors" title="Delete Story">
                                        <ion-icon name="trash-outline" class="text-xs"></ion-icon>
                                    </button>
                                </form>
                            }
                        </li>
                    }
                }
                else
                {
                    <li class="md:pr-3 pr-2">
                        <div class="md:w-16 md:h-16 w-12 h-12 bg-slate-200/60 rounded-full animate-pulse"></div>
                    </li>
                }

            </ul>
        </div>
    </div>
</div>
