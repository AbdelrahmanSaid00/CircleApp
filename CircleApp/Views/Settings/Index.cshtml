@model UpdateProfileVM

@{
    ViewData["Title"] = "Account Settings";
}

<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="max-w-[800px] mx-auto py-6">
        
        <!-- Header -->
        <div class="mb-6">
            <h2 class="text-2xl font-extrabold text-black flex items-center gap-2">
                <ion-icon name="settings-outline" class="text-2xl text-blue-600"></ion-icon>
                <span>Profile Settings</span>
            </h2>
            <p class="text-xs text-gray-500 mt-1">Manage your account details, profile picture, and security settings.</p>
        </div>

        <!-- Tabbed Navigation Header -->
        <div class="bg-white rounded-xl shadow-sm border1 p-2 mb-6">
            <ul class="flex flex-wrap gap-2 text-sm font-semibold text-gray-500" uk-switcher="connect: #settings-tabs; animation: uk-animation-fade">
                <li>
                    <a href="#" class="flex items-center gap-2 px-4 py-2.5 rounded-lg hover:bg-slate-100 transition-all cursor-pointer">
                        <ion-icon name="camera-outline" class="text-lg"></ion-icon>
                        <span>Update Picture</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="flex items-center gap-2 px-4 py-2.5 rounded-lg hover:bg-slate-100 transition-all cursor-pointer">
                        <ion-icon name="person-outline" class="text-lg"></ion-icon>
                        <span>Personal Info</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="flex items-center gap-2 px-4 py-2.5 rounded-lg hover:bg-slate-100 transition-all cursor-pointer">
                        <ion-icon name="lock-closed-outline" class="text-lg"></ion-icon>
                        <span>Change Password</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Tab Contents -->
        <ul id="settings-tabs" class="uk-switcher">
            
            <!-- 1) Update Profile Picture Form -->
            <li>
                <div class="bg-white rounded-xl shadow-sm border1 p-6 space-y-6">
                    <div>
                        <h3 class="text-base font-bold text-black">Update Profile Picture</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Upload a new profile image. Supported formats: JPG, PNG, GIF.</p>
                    </div>

                    <form asp-controller="Settings" asp-action="UpdateProfilePicture" method="post" enctype="multipart/form-data" class="space-y-6">
                        
                        <!-- Current Picture Preview -->
                        <div class="flex items-center gap-4">
                            <div class="relative w-20 h-20 rounded-full overflow-hidden border-2 border-slate-200 shadow-inner bg-slate-100 flex items-center justify-center">
                                <img src="@(string.IsNullOrEmpty(Model?.ProfilePictureUrl) ? "/images/avatar/user.png" : Model.ProfilePictureUrl)" 
                                     alt="Profile Picture" 
                                     class="w-full h-full object-cover" />
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-700 block">Current Photo</span>
                                <span class="text-xs text-gray-400">Choose a new file below to replace it</span>
                            </div>
                        </div>

                        <!-- File Input -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-2">Select Image File</label>
                            <input type="file" 
                                   name="profilePicture" 
                                   accept="image/*" 
                                   required 
                                   class="block w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 transition-all cursor-pointer" />
                        </div>

                        <!-- Submit Button -->
                        <div class="pt-2 border-t border-slate-100 flex justify-end">
                            <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white rounded-lg text-xs font-semibold hover:bg-blue-700 transition-colors shadow-sm">
                                Upload New Picture
                            </button>
                        </div>
                    </form>
                </div>
            </li>

            <!-- 2) Update Name / Info Form -->
            <li>
                <div class="bg-white rounded-xl shadow-sm border1 p-6 space-y-6">
                    <div>
                        <h3 class="text-base font-bold text-black">Update Personal Information</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Update your display name and basic account information.</p>
                    </div>

                    <form asp-controller="Settings" asp-action="UpdateProfile" method="post" class="space-y-4">
                        
                        <div>
                            <label asp-for="FullName" class="block text-xs font-semibold text-gray-700 mb-1">Full Name</label>
                            <input asp-for="FullName" 
                                   type="text" 
                                   placeholder="Enter your full name" 
                                   required 
                                   class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white transition-all" />
                            <span asp-validation-for="FullName" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="pt-4 border-t border-slate-100 flex justify-end">
                            <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white rounded-lg text-xs font-semibold hover:bg-blue-700 transition-colors shadow-sm">
                                Save Profile Changes
                            </button>
                        </div>
                    </form>
                </div>
            </li>

            <!-- 3) Change Password Form -->
            <li>
                <div class="bg-white rounded-xl shadow-sm border1 p-6 space-y-6">
                    <div>
                        <h3 class="text-base font-bold text-black">Change Password</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Ensure your account is using a long, random password to stay secure.</p>
                    </div>

                    <form asp-controller="Settings" asp-action="ChangePassword" method="post" class="space-y-4">
                        
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">Current Password</label>
                            <input type="password" 
                                   name="CurrentPassword" 
                                   placeholder="••••••••" 
                                   required 
                                   class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white transition-all" />
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">New Password</label>
                            <input type="password" 
                                   name="NewPassword" 
                                   placeholder="••••••••" 
                                   required 
                                   class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white transition-all" />
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">Confirm New Password</label>
                            <input type="password" 
                                   name="ConfirmNewPassword" 
                                   placeholder="••••••••" 
                                   required 
                                   class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white transition-all" />
                        </div>

                        <!-- Submit Button -->
                        <div class="pt-4 border-t border-slate-100 flex justify-end">
                            <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white rounded-lg text-xs font-semibold hover:bg-blue-700 transition-colors shadow-sm">
                                Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </li>

        </ul>

    </div>
</main>
